{
  "name": "puraskrit-website",
  "version": "0.1.0",
  "private": true,
  "description": "Puraskrit marketing website (customer + merchant modules). Static export, host-agnostic.",
  "scripts": {
    "prepare-content": "node scripts/copy-assets.mjs && node scripts/optimize-images.mjs && node scripts/convert-legal.mjs && node scripts/check-social.mjs",
    "predev": "npm run prepare-content",
    "dev": "next dev",
    "prebuild": "npm run prepare-content",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-copy.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:copy && npm run build && npm run check:copy:built",
    "check:copy:built": "node scripts/check-copy.mjs --built",
    "audit:layout": "node scripts/audit-layout.mjs"
  },
  "dependencies": {
    "motion": "^14.0.0",
    "next": "^15.5.27",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "mammoth": "^1.13.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}

# Copy to .env.local and fill in. All variables are public (baked into the static build).

# Canonical site URL, used for sitemap, robots and Open Graph. TODO(lead-dev): set the real domain.
NEXT_PUBLIC_SITE_URL=https://www.puraskrit.com

# Merchant lead form endpoint (POST, JSON body). TODO(lead-dev): backend not built yet.
# If empty: dev builds log the payload to the console and show success; production builds show "not configured".
NEXT_PUBLIC_LEAD_ENDPOINT=

# Google Play listing for the Buyer App. SAMPLE default is an invented package id. Replace at launch.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.puraskrit.customer

# App Store listing. Leave empty while iOS is not live (renders "Coming soon on iOS").
NEXT_PUBLIC_APP_STORE_URL=

# Show the "SAMPLE — replace before launch" markers. Set to false for the production launch build.
NEXT_PUBLIC_SHOW_SAMPLE_MARKER=true

# Analytics. Not used. TODO(lead-dev): add analytics + consent banner (default: decline non-essential).
NEXT_PUBLIC_ANALYTICS_ID=

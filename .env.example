# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.
# All variables are public: they are baked into the static build at build time,
# so changing one needs a redeploy. Never put secrets here.

# Canonical site URL, used for the sitemap, robots, canonical links and Open Graph.
# TODO(lead-dev): set the real domain.
NEXT_PUBLIC_SITE_URL=https://www.puraskrit.com

# Merchant form on /merchants/ ("Let's talk"). The form POSTs JSON to this address.
# TODO(lead-dev): backend not built yet. See README "Merchant form".
# If empty: dev builds log the entry to the console and show success;
#           production builds show "This form isn't connected yet".
NEXT_PUBLIC_LEAD_ENDPOINT=

# Google Play listing for the customer app. The default is a placeholder package id.
# The QR code in the download block is generated from this URL. Replace at launch.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.puraskrit.customer

# Google Play listing for the Seller App (merchant page only). The default is a placeholder.
NEXT_PUBLIC_SELLER_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.puraskrit.merchant

# App Store listing. Leave empty while iOS is not live: the site shows "Coming soon to iOS".
# When set, that note becomes a "Download for iOS" link.
NEXT_PUBLIC_APP_STORE_URL=

# Analytics. Not used. TODO(lead-dev): if added, also add a consent banner that
# defaults to declining non-essential cookies.
NEXT_PUBLIC_ANALYTICS_ID=
